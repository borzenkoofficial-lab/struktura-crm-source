{
  "name": "oplot",
  "version": "1.16.9",
  "private": true,
  "description": "ОПЛОТ — локальная система управления строительным бизнесом: заявки, клиенты, объекты, сметы, производство и финансы",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "node scripts/create-installer-assets.cjs && electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.6.2",
    "undici": "^7.10.0"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.struktura.crm",
    "productName": "ОПЛОТ",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Oplot-Setup-${version}.${ext}",
      "icon": "build/oplot.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/oplot.ico",
      "uninstallerIcon": "build/oplot.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "borzenkoofficial-lab",
        "repo": "struktura-crm-source"
      }
    ],
    "artifactName": "Oplot-Setup-${version}.${ext}"
  }
}
