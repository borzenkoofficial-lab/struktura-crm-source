{
  "name": "struktura-crm",
  "version": "1.14.0",
  "private": true,
  "description": "GRUZLI CRM — локальная настольная система управления клиентами, объектами, производством, сметами и финансами",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.struktura.crm",
    "productName": "GRUZLI CRM",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Struktura-CRM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "borzenkoofficial-lab",
        "repo": "struktura-crm-source"
      }
    ],
    "artifactName": "GRUZLI-CRM-Setup-${version}.${ext}"
  }
}
