{
  "name": "struktura-crm",
  "version": "1.13.10",
  "private": true,
  "description": "Настольная локальная CRM для Windows: клиенты, демонтаж, сметы, производство и PDF",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "ru.struktura.crm",
    "productName": "Struktura CRM",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Struktura-CRM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "publish": [
    {
      "provider": "github",
      "owner": "borzenkoofficial-lab",
      "repo": "struktura-crm-source"
    }
  ]
}
