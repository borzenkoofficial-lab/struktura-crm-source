{
  "name": "skol-desktop",
  "version": "1.25.0",
  "private": true,
  "description": "СКОЛ — локальная настольная система управления строительными заявками, объектами, производством, сметами и финансами",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "node scripts/create-installer-assets.cjs && electron-builder --win nsis",
    "license-manager": "electron tools/license-manager/main.cjs",
    "dist:license-manager": "electron-builder --win portable --config tools/license-manager/electron-builder.yml --publish never",
    "test:ui": "node tests/electron-layout-smoke.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.6.2",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.struktura.crm",
    "productName": "СКОЛ",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/skol.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SKOL-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/skol.ico",
      "uninstallerIcon": "build/skol.ico",
      "installerHeader": "build/skol-installer-header.bmp",
      "installerSidebar": "build/skol-installer-sidebar.bmp",
      "uninstallerSidebar": "build/skol-installer-sidebar.bmp",
      "include": "build/installer.nsh",
      "license": "build/license_ru.txt",
      "displayLanguageSelector": false,
      "language": "1049"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "borzenkoofficial-lab",
        "repo": "struktura-crm-source"
      }
    ],
    "artifactName": "SKOL-Setup-${version}.${ext}"
  }
}
